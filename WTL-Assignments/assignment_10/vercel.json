{
  "version": 2,
  "builds": [
    {
      "src": "api/summary.js",
      "use": "@vercel/node"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/summary",
      "dest": "/api/summary.js"
    },
    {
      "src": "/api/students/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/students",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
